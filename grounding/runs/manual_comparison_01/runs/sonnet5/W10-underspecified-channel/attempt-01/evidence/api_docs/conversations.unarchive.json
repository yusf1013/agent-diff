{
  "description": "Reverses conversation archival.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "ID of conversation to unarchive."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/conversations.unarchive\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\"\n     }'"
}
