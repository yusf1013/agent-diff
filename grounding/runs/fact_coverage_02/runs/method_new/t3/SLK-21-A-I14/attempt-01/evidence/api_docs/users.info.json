{
  "description": "Gets information about a user.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "user": {
        "type": "string",
        "required": true,
        "description": "User to get info on."
      },
      "include_locale": {
        "type": "boolean",
        "required": false,
        "description": "Set to true to receive the locale for this user. Default: false."
      }
    }
  },
  "example_request": "curl -X GET \"https://slack.com/api/users.info?user=U1234567890\" \\\n     -H \"Authorization: Bearer <TOKEN>\""
}
