{
  "description": "Invites users to a channel.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "The ID of the public or private channel to invite user(s) to."
      },
      "users": {
        "type": "string",
        "required": true,
        "description": "A comma separated list of user IDs. Up to 100 users may be listed."
      },
      "force": {
        "type": "boolean",
        "required": false,
        "description": "When true, continue inviting valid users while disregarding invalid IDs. Default: false."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/conversations.invite\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\",\n       \"users\": \"U1234567890,U0987654321\"\n     }'"
}
