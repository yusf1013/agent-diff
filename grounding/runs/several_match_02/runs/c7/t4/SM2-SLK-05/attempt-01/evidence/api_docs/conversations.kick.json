{
  "description": "Removes a user from a conversation.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "ID of conversation to remove user from."
      },
      "user": {
        "type": "string",
        "required": true,
        "description": "User ID to be removed."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/conversations.kick\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\",\n       \"user\": \"U1234567890\"\n     }'"
}
