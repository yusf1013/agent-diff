{"tests": [{"assertions": [{"diff_type": "added", "entity": "messages", "expected_count": 1, "where": {"channel_id": "@dm_diego"}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"channel_id": "@ch_atlas"}}], "expected": "Posts 'Standup moved to 10am' to the DM with Diego; posts nothing to #atlas.", "id": "T01", "request": "Please send 'Standup moved to 10am' to my direct message with Diego Alvarez. Don't post it in the #atlas channel.", "seed": [["channel", {"id": "C_ATLAS", "members": ["diego", "priya"], "name": "atlas", "ref": "ch_atlas"}], ["dm", {"id": "D_DIEGO", "person": "diego", "ref": "dm_diego"}]]}, {"assertions": [{"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@m_target", "reaction_type": "eyes"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@m_other"}}], "expected": "Adds an eyes reaction to the Q3 budget message with the approval block; leaves the other identical-text message alone.", "id": "T02", "request": "In #proposals there are two messages saying 'Q3 budget proposal'. Add an eyes reaction to the one whose block asks to approve the Q3 budget.", "seed": [["channel", {"id": "C_PROP", "members": ["diego", "priya"], "name": "proposals", "ref": "ch_prop"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "diego", "channel": "C_PROP", "ref": "m_target", "set": {"blocks": [{"text": {"text": "Approve the Q3 budget", "type": "mrkdwn"}, "type": "section"}]}, "text": "Q3 budget proposal"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "diego", "channel": "C_PROP", "ref": "m_other", "set": {"blocks": [{"text": {"text": "Q3 budget background figures", "type": "mrkdwn"}, "type": "section"}]}, "text": "Q3 budget proposal"}]]}, {"assertions": [{"diff_type": "added", "entity": "channel_members", "expected_count": 1, "where": {"channel_id": "@ch_ev", "user_id": "@tom_becker"}}, {"diff_type": "added", "entity": "channel_members", "expected_count": 0, "where": {"user_id": "@tom_other"}}], "expected": "Invites the Tom Becker with email tom.becker@example.com to #events; does not invite the other Tom Becker.", "id": "T03", "request": "Invite Tom Becker (tom.becker@example.com) to the #events channel.", "seed": [["person", {"key": "tom1", "name": "Tom Becker", "ref": "tom_becker", "set": {"email": "tom.becker@example.com"}}], ["person", {"key": "tom2", "name": "Tom Becker", "ref": "tom_other", "set": {"email": "tom.other@example.net"}}], ["channel", {"id": "C_EV", "members": ["priya"], "name": "events", "ref": "ch_ev"}]]}, {"assertions": [{"diff_type": "removed", "entity": "channel_members", "expected_count": 1, "where": {"channel_id": "@ch_sup", "user_id": "@bot_helper"}}, {"diff_type": "removed", "entity": "channel_members", "expected_count": 0, "where": {"user_id": "@human_helper"}}], "expected": "Kicks the bot user Helper from #support; the human Helper stays in the channel.", "id": "T04", "request": "Remove the bot account named Helper from the #support channel (the bot, not the human who is also called Helper).", "seed": [["person", {"key": "helper", "name": "Helper", "ref": "human_helper"}], ["person", {"bot": true, "key": "helpbot", "name": "Helper Bot", "ref": "bot_helper"}], ["channel", {"id": "C_SUP", "members": ["helper", "helpbot"], "name": "support", "ref": "ch_sup"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@m3"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@m1"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@m2"}}], "expected": "Deletes the message carrying both the thumbsup from Diego and the white_check_mark from Priya; leaves the messages with only one of them.", "id": "T05", "request": "Delete the message in #feedback that has both a thumbsup reaction from Diego Alvarez and a white_check_mark reaction from Priya Sharma.", "seed": [["channel", {"id": "C_FB", "members": ["diego", "priya", "leo"], "name": "feedback", "ref": "ch_fb"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "leo", "channel": "C_FB", "ref": "m1", "text": "New landing page draft"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_FB", "ref": "m2", "text": "Pricing table update"}], ["message", {"at": "2026-09-21T12:10:00Z", "author": "leo", "channel": "C_FB", "ref": "m3", "text": "Onboarding flow v2"}], ["reaction", {"at": "2026-09-21T12:15:00Z", "message": "@m1", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:16:00Z", "message": "@m2", "name": "white_check_mark", "person": "priya"}], ["reaction", {"at": "2026-09-21T12:17:00Z", "message": "@m3", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:18:00Z", "message": "@m3", "name": "white_check_mark", "person": "priya"}]]}, {"assertions": [{"diff_type": "changed", "entity": "channels", "expected_changes": {"is_archived": {"from": false, "to": true}}, "expected_count": 1, "where": {"channel_id": "@ch_gamma"}}, {"diff_type": "changed", "entity": "channels", "expected_count": 0, "where": {"channel_id": "@ch_alpha"}}, {"diff_type": "changed", "entity": "channels", "expected_count": 0, "where": {"channel_id": "@ch_beta"}}], "expected": "Archives #team-gamma, the channel containing both messages; leaves the channels with only one of them alone.", "id": "T06", "request": "Archive the channel that contains both a 'Deploy checklist for Friday release' message and a 'Rollback plan for Friday release' message.", "seed": [["channel", {"id": "C_ALPHA", "members": ["diego"], "name": "team-alpha", "ref": "ch_alpha"}], ["channel", {"id": "C_BETA", "members": ["diego"], "name": "team-beta", "ref": "ch_beta"}], ["channel", {"id": "C_GAMMA", "members": ["diego"], "name": "team-gamma", "ref": "ch_gamma"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "diego", "channel": "C_ALPHA", "ref": "dep_a", "text": "Deploy checklist for Friday release"}], ["message", {"at": "2026-09-21T12:01:00Z", "author": "diego", "channel": "C_BETA", "ref": "roll_b", "text": "Rollback plan for Friday release"}], ["message", {"at": "2026-09-21T12:02:00Z", "author": "diego", "channel": "C_GAMMA", "ref": "dep_g", "text": "Deploy checklist for Friday release"}], ["message", {"at": "2026-09-21T12:03:00Z", "author": "diego", "channel": "C_GAMMA", "ref": "roll_g", "text": "Rollback plan for Friday release"}]]}, {"assertions": [{"diff_type": "added", "entity": "messages", "expected_count": 1, "where": {"channel_id": "@dm_priya"}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"channel_id": "@dm_diego"}}], "expected": "Posts the reminder to the DM with Priya; posts nothing to the DM with Diego.", "id": "T07", "request": "Send 'Reminder: review due Friday' to my direct message with Priya Sharma.", "seed": [["dm", {"id": "D_DIEGO2", "person": "diego", "ref": "dm_diego"}], ["dm", {"id": "D_PRIYA", "person": "priya", "ref": "dm_priya"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@m_latest"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@m_old1"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@m_old2"}}], "expected": "Deletes the most recent message in #announcements; leaves the earlier messages alone.", "id": "T08", "request": "Delete the latest message in #announcements.", "seed": [["channel", {"id": "C_ANN", "members": ["diego"], "name": "announcements", "ref": "ch_ann"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "diego", "channel": "C_ANN", "ref": "m_old1", "text": "Kickoff notes"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "diego", "channel": "C_ANN", "ref": "m_old2", "text": "Agenda update"}], ["message", {"at": "2026-09-21T12:10:00Z", "author": "diego", "channel": "C_ANN", "ref": "m_latest", "text": "Final reminder for tomorrow"}]]}, {"assertions": [{"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@m_top", "reaction_type": "rocket"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@m_low"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@m_mid"}}], "expected": "Adds a rocket reaction to the 4-day-week message, the one with the most reactions; adds nothing to the other messages.", "id": "T09", "request": "Add a rocket reaction to the message in #ideas that has the most reactions.", "seed": [["channel", {"id": "C_IDEAS", "members": ["diego", "priya", "leo", "omar"], "name": "ideas", "ref": "ch_ideas"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "leo", "channel": "C_IDEAS", "ref": "m_low", "text": "Idea: standing desks"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_IDEAS", "ref": "m_mid", "text": "Idea: quiet room"}], ["message", {"at": "2026-09-21T12:10:00Z", "author": "leo", "channel": "C_IDEAS", "ref": "m_top", "text": "Idea: 4-day week trial"}], ["reaction", {"at": "2026-09-21T12:15:00Z", "message": "@m_low", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:15:00Z", "message": "@m_mid", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:16:00Z", "message": "@m_mid", "name": "tada", "person": "priya"}], ["reaction", {"at": "2026-09-21T12:15:00Z", "message": "@m_top", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:16:00Z", "message": "@m_top", "name": "tada", "person": "priya"}], ["reaction", {"at": "2026-09-21T12:17:00Z", "message": "@m_top", "name": "eyes", "person": "leo"}], ["reaction", {"at": "2026-09-21T12:18:00Z", "message": "@m_top", "name": "white_check_mark", "person": "omar"}]]}, {"assertions": [{"diff_type": "added", "entity": "channel_members", "expected_count": 0, "where": {"channel_id": "@ch_ev2"}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"channel_id": "@ch_ev2"}}], "expected": "Says no workspace user has that email and changes nothing.", "id": "T10", "request": "Invite jordan.lee@example.com to the #events2 channel.", "seed": [["person", {"key": "nina", "name": "Nina Patel", "ref": "nina", "set": {"email": "nina.patel@example.com"}}], ["channel", {"id": "C_EV2", "members": ["priya"], "name": "events2", "ref": "ch_ev2"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"channel_id": "@ch_fb"}}], "expected": "Says no message in #feedback has both reactions and deletes nothing.", "id": "T11", "request": "Delete the message in #feedback that has both a thumbsup reaction from Diego Alvarez and a white_check_mark reaction from Priya Sharma.", "seed": [["channel", {"id": "C_FB2", "members": ["diego", "priya", "leo"], "name": "feedback", "ref": "ch_fb"}], ["message", {"at": "2026-09-21T12:00:00Z", "author": "leo", "channel": "C_FB2", "ref": "m1", "text": "New landing page draft"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_FB2", "ref": "m2", "text": "Pricing table update"}], ["reaction", {"at": "2026-09-21T12:15:00Z", "message": "@m1", "name": "thumbsup", "person": "diego"}], ["reaction", {"at": "2026-09-21T12:16:00Z", "message": "@m2", "name": "white_check_mark", "person": "priya"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"channel_id": "@ch_empty"}}], "expected": "Says #empty has no messages and deletes nothing.", "id": "T12", "request": "Delete the latest message in #empty.", "seed": [["channel", {"id": "C_EMPTY", "members": ["priya"], "name": "empty", "ref": "ch_empty"}]]}]}
