{"tests": [
  {"id": "T01",
   "request": "Please cancel my 'Dentist appointment' on Thursday morning.",
   "seed": [["event", {"calendar": "primary", "end": "2018-06-21T11:00:00", "id": "ev_dentist", "start": "2018-06-21T10:00:00", "summary": "Dentist appointment"}],
            ["event", {"calendar": "primary", "end": "2018-06-21T11:00:00", "id": "ev_standup", "start": "2018-06-21T10:00:00", "summary": "Team standup"}]],
   "expected": "Delete the 'Dentist appointment' event on Thursday morning and confirm it; leave the 'Team standup' at the same time untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_dentist"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_standup"}}]},
  {"id": "T02",
   "request": "Please add 'bring laptop' to the description of my 9am '1:1 with Priya' on Wednesday.",
   "seed": [["event", {"calendar": "primary", "end": "2018-06-20T09:30:00", "id": "ev_nine", "start": "2018-06-20T09:00:00", "summary": "1:1 with Priya"}],
            ["event", {"calendar": "primary", "end": "2018-06-20T14:30:00", "id": "ev_two", "start": "2018-06-20T14:00:00", "summary": "1:1 with Priya"}]],
   "expected": "Add the note to the description of the 9am Wednesday '1:1 with Priya' and confirm; leave the 2pm one unchanged.",
   "assertions": [{"diff_type": "changed", "entity": "calendar_events", "expected_changes": {"description": {"from": "", "to": {"contains": "bring laptop"}}}, "expected_count": 1, "where": {"id": "ev_nine"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_two"}}]},
  {"id": "T03",
   "request": "Please cancel the 'Sprint demo' in Room B on Friday afternoon.",
   "seed": [["event", {"calendar": "primary", "end": "2018-06-22T16:00:00", "id": "ev_rooma", "location": "Room A", "start": "2018-06-22T15:00:00", "summary": "Sprint demo"}],
            ["event", {"calendar": "primary", "end": "2018-06-22T16:00:00", "id": "ev_roomb", "location": "Room B", "start": "2018-06-22T15:00:00", "summary": "Sprint demo"}]],
   "expected": "Delete the 'Sprint demo' in Room B and confirm; leave the one in Room A untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_roomb"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_rooma"}}]},
  {"id": "T04",
   "request": "Please delete the 'Focus block' on Friday morning that shows as free (available).",
   "seed": [["event", {"calendar": "primary", "end": "2018-06-22T10:00:00", "id": "ev_free", "start": "2018-06-22T09:00:00", "summary": "Focus block", "transparency": "transparent"}],
            ["event", {"calendar": "primary", "end": "2018-06-22T10:00:00", "id": "ev_busy", "start": "2018-06-22T09:00:00", "summary": "Focus block", "transparency": "opaque"}]],
   "expected": "Delete the 'Focus block' marked as free/available and confirm; leave the busy one untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_free"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_busy"}}]},
  {"id": "T05",
   "request": "Please cancel the 'Launch sync' organized by Priya Nair that Omar Haddad created.",
   "seed": [["event", {"calendar": "primary", "creator": "omar", "end": "2018-06-21T15:00:00", "id": "ev_target", "organizer": "priya", "start": "2018-06-21T14:00:00", "summary": "Launch sync"}],
            ["event", {"calendar": "primary", "creator": "omar", "end": "2018-06-21T15:00:00", "id": "ev_org", "organizer": "omar", "start": "2018-06-21T14:00:00", "summary": "Launch sync"}],
            ["event", {"calendar": "primary", "creator": "priya", "end": "2018-06-21T15:00:00", "id": "ev_cre", "organizer": "priya", "start": "2018-06-21T14:00:00", "summary": "Launch sync"}]],
   "expected": "Delete the 'Launch sync' organized by Priya Nair and created by Omar Haddad and confirm; leave the other 'Launch sync' events untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_target"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_org"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_cre"}}]},
  {"id": "T06",
   "request": "Please cancel the 'Design review' where Omar Haddad accepted but Priya Nair declined.",
   "seed": [["event", {"attendees": [["omar", "accepted"], ["priya", "declined"]], "calendar": "primary", "end": "2018-06-21T11:00:00", "id": "ev_target", "start": "2018-06-21T10:00:00", "summary": "Design review"}],
            ["event", {"attendees": [["omar", "accepted"], ["priya", "accepted"]], "calendar": "primary", "end": "2018-06-21T11:00:00", "id": "ev_other", "start": "2018-06-21T10:00:00", "summary": "Design review"}]],
   "expected": "Delete the 'Design review' with Omar accepted and Priya declined and confirm; leave the one where Priya accepted untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_target"}},
                  {"diff_type": "unchanged", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_other"}}]},
  {"id": "T07",
   "request": "Please rename the 'Team calendar' owned by Kenji Sato to 'Team calendar (archived)'.",
   "seed": [["calendar", {"id": "team-kenji@northwind.example", "owner": "kenji", "summary": "Team calendar"}],
            ["calendar", {"id": "team-jordan@northwind.example", "owner": "actor", "summary": "Team calendar"}]],
   "expected": "Update the summary of the 'Team calendar' owned by Kenji Sato and confirm; leave the one I own unchanged.",
   "assertions": [{"diff_type": "changed", "entity": "calendars", "expected_changes": {"summary": {"from": "Team calendar", "to": {"contains": "archived"}}}, "expected_count": 1, "where": {"id": "team-kenji@northwind.example"}},
                  {"diff_type": "unchanged", "entity": "calendars", "expected_count": 1, "where": {"id": "team-jordan@northwind.example"}}]},
  {"id": "T08",
   "request": "Please update the description of my 'Regional schedule' calendar that uses Tokyo time to 'Regional marketing schedule'.",
   "seed": [["calendar", {"id": "regional-tokyo@northwind.example", "summary": "Regional schedule", "tz": "Asia/Tokyo"}],
            ["calendar", {"id": "regional-la@northwind.example", "summary": "Regional schedule", "tz": "America/Los_Angeles"}]],
   "expected": "Update the description of the Tokyo-time 'Regional schedule' calendar and confirm; leave the Los Angeles-time one unchanged.",
   "assertions": [{"diff_type": "changed", "entity": "calendars", "expected_changes": {"description": {"from": "", "to": {"contains": "Regional marketing"}}}, "expected_count": 1, "where": {"id": "regional-tokyo@northwind.example"}},
                  {"diff_type": "unchanged", "entity": "calendars", "expected_count": 1, "where": {"id": "regional-la@northwind.example"}}]},
  {"id": "T09",
   "request": "Please hide the 'Partner sync' calendar where I only have reader access from my calendar list view.",
   "seed": [["calendar", {"access": "reader", "id": "partner-reader@northwind.example", "summary": "Partner sync"}],
            ["calendar", {"access": "writer", "id": "partner-writer@northwind.example", "summary": "Partner sync"}]],
   "expected": "Hide the list entry of the 'Partner sync' calendar where I have reader access and confirm; leave the writer-access one visible.",
   "assertions": [{"diff_type": "changed", "entity": "calendar_list_entries", "expected_changes": {"hidden": {"from": false, "to": true}}, "expected_count": 1, "where": {"calendar_id": "partner-reader@northwind.example"}},
                  {"diff_type": "unchanged", "entity": "calendar_list_entries", "expected_count": 1, "where": {"calendar_id": "partner-writer@northwind.example"}}]},
  {"id": "T10",
   "request": "Please unhide the hidden calendar showing as 'Side gig' in my list.",
   "seed": [["calendar", {"hidden": true, "id": "side-gig@northwind.example", "override": "Side gig", "summary": "Contract work"}],
            ["calendar", {"hidden": false, "id": "contract-main@northwind.example", "summary": "Contract work"}]],
   "expected": "Unhide the list entry showing as 'Side gig' and confirm; leave the other 'Contract work' calendar alone.",
   "assertions": [{"diff_type": "changed", "entity": "calendar_list_entries", "expected_changes": {"hidden": {"from": true, "to": false}}, "expected_count": 1, "where": {"calendar_id": "side-gig@northwind.example"}},
                  {"diff_type": "unchanged", "entity": "calendar_list_entries", "expected_count": 1, "where": {"calendar_id": "contract-main@northwind.example"}}]},
  {"id": "T11",
