            ["event", {"calendar": "secondary-team@northwind.example", "end": "2018-06-18T11:00:00", "id": "ev_sec", "start": "2018-06-18T10:00:00", "summary": "Budget review"}]],
   "expected": "Delete Monday morning's 'Budget review' on the primary calendar and confirm; leave Tuesday's and the secondary-calendar one untouched.",
   "assertions": [{"diff_type": "removed", "entity": "calendar_events", "expected_count": 1, "where": {"id": "ev_mon"}},
