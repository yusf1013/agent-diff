    ["task", {"id": "84011", "file": "8401", "creator": "JL", "message": "Review vendor terms"}],
    ["assign", {"id": "840111", "task": "84011", "to": "DW", "by": "LP", "state": "completed"}],
    ["task", {"id": "84021", "file": "8402", "creator": "JL", "message": "Review vendor terms"}],
    ["assign", {"id": "840211", "task": "84021", "to": "DW", "by": "LP", "state": "incomplete"}],
    ["task", {"id": "84031", "file": "8403", "creator": "JL", "message": "Review vendor terms"}],
    ["assign", {"id": "840311", "task": "84031", "to": "DW", "by": "MC", "state": "completed"}]],
   "expected": "A correct assistant adds the comment to the Vendor Agreement pdf whose Leo Park-assigned task is completed, and touches nothing else.",
   "assertions": [{"diff_type": "added", "entity": "box_comments", "where": {"file_id": "@k1", "message": {"contains": "All set"}}, "expected_count": 1},
    {"diff_type": "added", "entity": "box_comments", "expected_count": 1}]},
