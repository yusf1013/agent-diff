{"tests": [
  {"id": "T01",
   "request": "Please add a comment saying 'Looks good \u2014 approved.' to the most recently modified Q3 Forecast spreadsheet.",
   "seed": [["folder", {"id": "8100", "name": "Reports"}],
    ["file", {"id": "8101", "name": "Q3 Forecast.xlsx", "parent": "8100", "modified": "2026-05-02T09:00:00+00:00", "ref": "k1"}],
    ["file", {"id": "8102", "name": "Q3 Forecast.xlsx", "parent": "8100", "modified": "2026-08-20T09:00:00+00:00", "ref": "k2"}]],
   "expected": "A correct assistant adds the comment to the August version of Q3 Forecast.xlsx and touches nothing else.",
   "assertions": [{"diff_type": "added", "entity": "box_comments", "where": {"file_id": "@k2", "message": {"contains": "approved"}}, "expected_count": 1},
    {"diff_type": "added", "entity": "box_comments", "expected_count": 1}]},
  {"id": "T02",
