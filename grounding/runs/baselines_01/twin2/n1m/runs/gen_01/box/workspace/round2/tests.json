    ["file", {"id": "8202", "name": "Launch Plan.pdf", "parent": "8200", "shared": "company", "ref": "k2"}]],
   "expected": "A correct assistant adds the comment to the Launch Plan pdf that already has a shared link and touches nothing else.",
   "assertions": [{"diff_type": "added", "entity": "box_comments", "where": {"file_id": "@k2", "message": {"contains": "Reviewed"}}, "expected_count": 1},
    {"diff_type": "added", "entity": "box_comments", "expected_count": 1}]},
