{"tests": [{"assertions": [{"diff_type": "added", "entity": "messages", "expected_count": 1, "where": {"channel_id": "C_T01B"}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"channel_id": "C_T01A"}}], "expected": "Post the message in the channel named exactly #river and make no change in #riverbank.", "id": "T01", "request": "Please post the message `gauge check at noon` in the #river channel.", "seed": [["channel", {"id": "C_T01A", "members": ["priya"], "name": "riverbank"}], ["channel", {"id": "C_T01B", "members": ["priya"], "name": "river"}], ["message", {"at": "2026-09-21T12:02:00Z", "author": "priya", "channel": "C_T01A", "ref": "m1", "text": "Riverbank cleanup rota is up."}], ["message", {"at": "2026-09-21T12:04:00Z", "author": "priya", "channel": "C_T01B", "ref": "m2", "text": "River gauge calibration due Friday."}]]}, {"assertions": [{"diff_type": "added", "entity": "channel_members", "expected_count": 1, "where": {"channel_id": "C_T02A", "user_id": "@u1"}}, {"diff_type": "added", "entity": "channel_members", "expected_count": 0, "where": {"channel_id": "C_T02A", "user_id": "@u2"}}], "expected": "Invite Tara Reyes, the Tara with last name Reyes, to #field-trip; do not invite the other Tara.", "id": "T02", "request": "Please invite Tara Reyes to #field-trip.", "seed": [["person", {"key": "tx1", "name": "Tara Reyes", "ref": "u1"}], ["person", {"key": "tx2", "name": "Tara Novak", "ref": "u2"}], ["channel", {"id": "C_T02A", "members": ["priya"], "name": "field-trip"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@s1"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@s2"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@s3"}}], "expected": "Delete only Diego's `deploy is green` message in #harbor; spare the same text by Leo and the one in the other channel.", "id": "T03", "request": "Delete Diego's message saying `deploy is green` in #harbor.", "seed": [["channel", {"id": "C_T03A", "members": ["diego", "leo"], "name": "harbor"}], ["channel", {"id": "C_T03B", "members": ["diego", "leo"], "name": "lagoon"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "diego", "channel": "C_T03A", "ref": "s1", "text": "deploy is green"}], ["message", {"at": "2026-09-21T12:07:00Z", "author": "leo", "channel": "C_T03A", "ref": "s2", "text": "deploy is green"}], ["message", {"at": "2026-09-21T12:09:00Z", "author": "diego", "channel": "C_T03B", "ref": "s3", "text": "deploy is green"}]]}, {"assertions": [{"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@d1", "reaction_type": "eyes"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@d2"}}], "expected": "Add the eyes reaction to Leo's September 21st message only; leave the identical September 22nd message alone.", "id": "T04", "request": "Add an eyes reaction to Leo's `db failover starting` message from Monday, September 21st in #ops.", "seed": [["channel", {"id": "C_T04A", "members": ["leo", "priya"], "name": "ops"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_T04A", "ref": "d1", "text": "db failover starting, holding writes"}], ["message", {"at": "2026-09-22T12:05:00Z", "author": "leo", "channel": "C_T04A", "ref": "d2", "text": "db failover starting, holding writes"}]]}, {"assertions": [{"diff_type": "changed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@e1"}}, {"diff_type": "changed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@e0"}}, {"diff_type": "changed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@e2"}}], "expected": "Update only that thread reply; leave the thread parent and the other reply unchanged.", "id": "T05", "request": "In #release, update Leo's thread reply saying `nit: flip the flag order` to read `nit: flip the flag order (done)`.", "seed": [["channel", {"id": "C_T05A", "members": ["diego", "leo"], "name": "release"}], ["message", {"at": "2026-09-21T12:02:00Z", "author": "diego", "channel": "C_T05A", "ref": "e0", "text": "release plan v2 is up"}], ["message", {"at": "2026-09-21T12:06:00Z", "author": "leo", "channel": "C_T05A", "parent": "@e0", "ref": "e1", "text": "nit: flip the flag order"}], ["message", {"at": "2026-09-21T12:08:00Z", "author": "leo", "channel": "C_T05A", "parent": "@e0", "ref": "e2", "text": "lgtm, ship it"}]]}, {"assertions": [{"diff_type": "removed", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@f1", "reaction_type": "eyes"}}, {"diff_type": "removed", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@f1", "reaction_type": "thumbsup"}}], "expected": "Remove only Priya's eyes reaction on that message; keep her thumbsup reaction there.", "id": "T06", "request": "Remove Priya's eyes reaction from the `new logo draft` message in #design.", "seed": [["channel", {"id": "C_T06A", "members": ["diego", "priya"], "name": "design"}], ["message", {"at": "2026-09-21T12:03:00Z", "author": "diego", "channel": "C_T06A", "ref": "f1", "text": "new logo draft is up"}], ["reaction", {"at": "2026-09-21T12:10:00Z", "message": "@f1", "name": "eyes", "person": "priya"}], ["reaction", {"at": "2026-09-21T12:11:00Z", "message": "@f1", "name": "thumbsup", "person": "priya"}]]}, {"assertions": [{"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@g1", "reaction_type": "white_check_mark"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@g2", "reaction_type": "white_check_mark"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@g3", "reaction_type": "white_check_mark"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@g4"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@g5"}}], "expected": "React with white_check_mark on all three of Omar's `invoice ready` messages and on nothing else.", "id": "T07", "request": "Add a white_check_mark reaction to every message by Omar saying `invoice ready` in #billing.", "seed": [["channel", {"id": "C_T07A", "members": ["leo", "omar"], "name": "billing"}], ["message", {"at": "2026-09-21T12:02:00Z", "author": "omar", "channel": "C_T07A", "ref": "g1", "text": "invoice ready for Acme"}], ["message", {"at": "2026-09-21T12:04:00Z", "author": "omar", "channel": "C_T07A", "ref": "g2", "text": "invoice ready for Globex"}], ["message", {"at": "2026-09-21T12:06:00Z", "author": "omar", "channel": "C_T07A", "ref": "g3", "text": "invoice ready for Initech"}], ["message", {"at": "2026-09-21T12:08:00Z", "author": "leo", "channel": "C_T07A", "ref": "g4", "text": "invoice ready for Umbrella"}], ["message", {"at": "2026-09-21T12:10:00Z", "author": "omar", "channel": "C_T07A", "ref": "g5", "text": "invoice draft for Hooli"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@h2"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@h1"}}], "expected": "Delete only Leo's `standup moved` message; leave Diego's identical message in place.", "id": "T08", "request": "In #standup, delete the message saying `standup moved` that is NOT by Diego.", "seed": [["channel", {"id": "C_T08A", "members": ["diego", "leo"], "name": "standup"}], ["message", {"at": "2026-09-21T12:02:00Z", "author": "diego", "channel": "C_T08A", "ref": "h1", "text": "standup moved to 10:00"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_T08A", "ref": "h2", "text": "standup moved to 10:00"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": {"exists": true}}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"message_id": {"exists": true}}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": {"exists": true}}}], "expected": "Change nothing in the workspace and reply that no message matches; the dusk message is not a match.", "id": "T09", "request": "Delete the message saying `rocket launch at dawn` in #launches.", "seed": [["channel", {"id": "C_T09A", "members": ["priya"], "name": "launches"}], ["message", {"at": "2026-09-21T12:03:00Z", "author": "priya", "channel": "C_T09A", "ref": "n1", "text": "rocket launch at dusk is a go"}]]}, {"assertions": [{"diff_type": "removed", "entity": "messages", "expected_count": 1, "where": {"message_id": "@j3"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@j1"}}, {"diff_type": "removed", "entity": "messages", "expected_count": 0, "where": {"message_id": "@j2"}}], "expected": "Delete only the newest (12:50) of the three identical messages; keep the two earlier ones.", "id": "T10", "request": "Delete the latest message by Aisha saying `build passed` in #ci.", "seed": [["channel", {"id": "C_T10A", "members": ["aisha"], "name": "ci"}], ["message", {"at": "2026-09-21T11:10:00Z", "author": "aisha", "channel": "C_T10A", "ref": "j1", "text": "build passed on main"}], ["message", {"at": "2026-09-21T12:10:00Z", "author": "aisha", "channel": "C_T10A", "ref": "j2", "text": "build passed on main"}], ["message", {"at": "2026-09-21T12:50:00Z", "author": "aisha", "channel": "C_T10A", "ref": "j3", "text": "build passed on main"}]]}, {"assertions": [{"diff_type": "added", "entity": "messages", "expected_count": 1, "where": {"channel_id": "C_T11B"}}, {"diff_type": "added", "entity": "messages", "expected_count": 0, "where": {"channel_id": "C_T11A"}}], "expected": "Post in #sunset, the channel whose topic is `aurora alerts`; do not post in #aurora.", "id": "T11", "request": "Post `drill at 15:00` in the channel whose topic is `aurora alerts`.", "seed": [["channel", {"id": "C_T11A", "members": ["priya"], "name": "aurora", "topic": "sunset photos"}], ["channel", {"id": "C_T11B", "members": ["priya"], "name": "sunset", "topic": "aurora alerts"}]]}, {"assertions": [{"diff_type": "added", "entity": "message_reactions", "expected_count": 1, "where": {"message_id": "@k2", "reaction_type": "eyes"}}, {"diff_type": "added", "entity": "message_reactions", "expected_count": 0, "where": {"message_id": "@k1"}}], "expected": "React only on the message authored by Leo; ignore the message that merely mentions him.", "id": "T12", "request": "Add an eyes reaction to Leo's message asking for a diff review in #reviews \u2014 the one he wrote himself.", "seed": [["channel", {"id": "C_T12A", "members": ["diego", "leo"], "name": "reviews"}], ["message", {"at": "2026-09-21T12:03:00Z", "author": "diego", "channel": "C_T12A", "mentions": ["leo"], "ref": "k1", "text": "Leo can you review the diff?"}], ["message", {"at": "2026-09-21T12:05:00Z", "author": "leo", "channel": "C_T12A", "ref": "k2", "text": "can someone review my diff?"}]]}]}