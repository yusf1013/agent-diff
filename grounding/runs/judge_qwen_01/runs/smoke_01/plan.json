{
 "settings": {
  "backend": "qwen-selfhost",
  "host": "selfhost",
  "endpoint": "http://127.0.0.1:18000/v1/chat/completions",
  "model": "qwen3.8-27b",
  "max_tokens": 16384,
  "timeout_s": 1800.0,
  "http_attempts": 4,
  "limiter_file": "/tmp/qwen_selfhost_rate_limit.json",
  "limiter_per_minute": "110",
  "sampling": "provider defaults",
  "thinking": "provider default (on)"
 },
 "concurrency": 3,
 "schema": {
  "type": "object",
  "properties": {
   "outcome": {
    "type": "string",
    "enum": [
     "incorrect",
     "presented",
     "correct",
     "correct_absent",
     "false_absence",
     "incomplete",
     "not_established",
     "artifact"
    ]
   },
   "acted_on": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "ids of records the solver acted on or presented as the match"
   },
   "exposed": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "facts exposed (decoys' facts)"
   },
   "mechanism": {
    "type": "string",
    "enum": [
     "skipped-check",
     "saw-mismatch-accepted",
     "misread",
     "none"
    ]
   },
   "artifact_reason": {
    "type": "string",
    "description": "for artifact: the replica behaviour or test defect"
   },
   "note": {
    "type": "string",
    "description": "1-3 sentences citing the decisive steps"
   }
  },
  "required": [
   "outcome",
   "acted_on",
   "exposed",
   "mechanism",
   "artifact_reason",
   "note"
  ],
  "additionalProperties": false
 }
}
