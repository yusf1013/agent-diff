{"tests": [
  {"id": "T01",
   "request": "Bump OPS-12 to urgent priority please.",
   "seed": [
     ["team", {"id": "tm-4a", "name": "Web", "key": "WEB"}],
     ["team", {"id": "tm-7c", "name": "Ops", "key": "OPS"}],
     ["member", {"team": "tm-4a", "person": "actor"}],
     ["member", {"team": "tm-7c", "person": "actor"}],
     ["issue", {"id": "i-e31", "team": "tm-4a", "number": 12, "title": "Rotate API signing keys", "priority": 3}],
     ["issue", {"id": "i-e32", "team": "tm-4a", "number": 30, "title": "Blocked by OPS-12: staging key rollout", "priority": 3}],
     ["issue", {"id": "i-e33", "team": "tm-7c", "number": 12, "title": "Rotate API signing keys", "priority": 3}],
     ["issue", {"id": "i-e34", "team": "tm-7c", "number": 21, "title": "Rotate API signing keys", "priority": 3}]
   ],
   "expected": "The assistant finds the issue whose identifier is exactly OPS-12 (the Ops team's issue number 12) and sets its priority to urgent (1). It does not touch WEB-12 (same number and same title, other team), WEB-30 (whose title mentions OPS-12) or OPS-21 (same title).",
   "assertions": [
     {"diff_type": "changed", "entity": "issues", "where": {"id": "i-e33"}, "expected_count": 1, "expected_changes": {"priority": {"from": 3, "to": 1}}},
     {"diff_type": "changed", "entity": "issues", "where": {"id": {"in": ["i-e31", "i-e32", "i-e34"]}}, "expected_count": 0}
   ]},

