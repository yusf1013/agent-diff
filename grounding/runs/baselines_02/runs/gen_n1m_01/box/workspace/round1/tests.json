{"tests": [
  {"id": "T01",
   "request": "Rename the Acme Services Agreement that was last modified on 12 August 2026 to \"Acme Services Agreement - Signed.pdf\".",
   "seed": [
     ["folder", {"id": "4410", "name": "Drafts"}],
     ["folder", {"id": "4411", "name": "Legal Review"}],
     ["folder", {"id": "4412", "name": "Archive"}],
     ["file", {"id": "4421", "name": "Acme Services Agreement.pdf", "parent": "4412", "description": "Services agreement with Acme", "created": "2026-03-02T10:00:00+00:00", "modified": "2026-08-11T12:00:00+00:00"}],
     ["file", {"id": "4422", "name": "Acme Services Agreement.pdf", "parent": "4410", "description": "Services agreement with Acme", "created": "2026-08-12T12:00:00+00:00", "modified": "2026-08-20T12:00:00+00:00"}],
     ["file", {"id": "4423", "name": "Acme Services Agreement.pdf", "parent": "4411", "description": "Services agreement with Acme", "created": "2026-02-10T10:00:00+00:00", "modified": "2026-08-13T12:00:00+00:00"}]
   ],
   "expected": "No copy of the Acme Services Agreement was last modified on 12 August 2026 (one was created that day, the others were last modified on 11 and 13 August and 20 August). The assistant should rename nothing and tell Jordan that no file matches.",
   "assertions": [
     {"diff_type": "changed", "entity": "box_files", "where": {}, "expected_count": 0},
     {"diff_type": "added", "entity": "box_files", "where": {}, "expected_count": 0},
     {"diff_type": "removed", "entity": "box_files", "where": {}, "expected_count": 0}
   ]},

  {"id": "T02",
   "request": "Post a comment saying \"Link expires Friday\" on the Pricing Sheet that has a shared link.",
   "seed": [
     ["folder", {"id": "4510", "name": "Sales"}],
     ["folder", {"id": "4511", "name": "Finance"}],
     ["folder", {"id": "4512", "name": "Partners"}],
     ["file", {"id": "4521", "name": "Pricing Sheet.xlsx", "parent": "4510", "description": "Current price list"}],
     ["file", {"id": "4522", "name": "Pricing Sheet.xlsx", "parent": "4512", "description": "Current price list", "shared": "open"}],
     ["file", {"id": "4523", "name": "Pricing Sheet.xlsx", "parent": "4511", "description": "Current price list"}],
     ["file", {"id": "4524", "name": "Pricing Sheet - public.xlsx", "parent": "4511", "description": "Current price list"}]
   ],
   "expected": "Only the Pricing Sheet in the Partners folder (4522) has a shared link. The assistant should add the comment \"Link expires Friday\" to that file and to no other, ignoring the file whose name merely says \"public\".",
   "assertions": [
     {"diff_type": "added", "entity": "box_comments", "where": {"item_id": "4522", "message": {"i_contains": "Link expires Friday"}}, "expected_count": 1},
     {"diff_type": "added", "entity": "box_comments", "where": {"item_id": {"ne": "4522"}}, "expected_count": 0}
   ]},

  {"id": "T03",
