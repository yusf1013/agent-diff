  {"id": "T05",
   "request": "On Release Plan.docx, reply \"Unblocked now, legal signed off\" to the original \"Can we ship on Friday?\" comment that Leo Park answered with \"Blocked on legal\".",
   "seed": [
     ["file", {"id": "4810", "name": "Release Plan.docx", "parent": "0"}],
     ["comment", {"id": "48201", "file": "4810", "author": "OH", "message": "Can we ship on Friday?"}],
     ["comment", {"id": "48202", "file": "4810", "author": "SR", "message": "Blocked on legal", "reply_to": "48201"}],
     ["comment", {"id": "48203", "file": "4810", "author": "MC", "message": "Can we ship on Friday?"}],
     ["comment", {"id": "48204", "file": "4810", "author": "LP", "message": "Blocked on legal", "reply_to": "48203"}],
     ["comment", {"id": "48205", "file": "4810", "author": "PN", "message": "Can we ship on Friday?"}],
     ["comment", {"id": "48206", "file": "4810", "author": "LP", "message": "Yes, we are good", "reply_to": "48205"}]
   ],
   "expected": "Leo's \"Blocked on legal\" reply (48204) answers comment 48203. The assistant should post the reply on the parent comment 48203 as a reply (item type comment), not on Leo's reply or on the other identical questions.",
   "assertions": [
     {"diff_type": "added", "entity": "box_comments", "where": {"item_id": "48203", "item_type": "comment", "message": {"i_contains": "legal signed off"}}, "expected_count": 1},
     {"diff_type": "added", "entity": "box_comments", "where": {"item_id": {"ne": "48203"}}, "expected_count": 0}
   ]},

