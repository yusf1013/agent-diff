  {"id": "T12",
   "request": "Change the location of the Pricing review on Tuesday June 26 that Dana declined to 'Board room'.",
   "seed": [
     ["event", {"id": "ev_x01", "calendar": "primary", "summary": "Pricing review", "start": "2018-06-26T10:00:00", "end": "2018-06-26T11:00:00", "location": "Room 1", "attendees": [["dana", "accepted"], ["priya", "accepted"]]}],
     ["event", {"id": "ev_x02", "calendar": "primary", "summary": "Pricing review", "start": "2018-06-27T10:00:00", "end": "2018-06-27T11:00:00", "location": "Room 1", "attendees": [["dana", "declined"], ["priya", "accepted"]]}],
     ["event", {"id": "ev_x03", "calendar": "primary", "summary": "Pricing review", "start": "2018-06-26T15:00:00", "end": "2018-06-26T16:00:00", "location": "Room 1", "attendees": [["dana", "tentative"], ["priya", "declined"]]}]
   ],
   "expected": "No Pricing review on Tuesday June 26 has Dana as declined (the declined one is on June 27, and the June 26 ones were accepted or tentative for Dana). The assistant changes nothing and tells Jordan that no matching event exists.",
   "assertions": [
