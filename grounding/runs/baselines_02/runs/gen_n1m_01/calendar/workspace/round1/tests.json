   ]},

  {"id": "T10",
   "request": "Rename the Planning meeting where Omar declined to 'Planning meeting (Omar out)'.",
   "seed": [
     ["event", {"id": "ev_p11", "calendar": "primary", "summary": "Planning meeting", "start": "2018-06-18T10:00:00", "end": "2018-06-18T11:00:00", "attendees": [["omar", "accepted"], ["priya", "declined"]]}],
     ["event", {"id": "ev_p12", "calendar": "primary", "summary": "Planning meeting", "start": "2018-06-20T10:00:00", "end": "2018-06-20T11:00:00", "attendees": [["omar", "tentative"], ["priya", "tentative"]]}],
     ["event", {"id": "ev_p13", "calendar": "primary", "summary": "Planning meeting", "start": "2018-06-19T10:00:00", "end": "2018-06-19T11:00:00", "attendees": [["omar", "declined"], ["priya", "accepted"]]}],
     ["event", {"id": "ev_p14", "calendar": "primary", "summary": "Planning meeting", "start": "2018-06-21T10:00:00", "end": "2018-06-21T11:00:00", "attendees": [["omar", "needsAction"], ["sam", "declined"]]}]
   ],
