{"tests": [
  {"id": "T01",
   "request": "Rename my 'Roadmap review - Q3' meeting to 'Roadmap review - Q3 (final)'.",
   "seed": [
     ["event", {"id": "ev_h01", "calendar": "primary", "summary": "Roadmap review - Q3 (draft)", "start": "2018-06-18T10:00:00", "end": "2018-06-18T11:00:00"}],
     ["event", {"id": "ev_h02", "calendar": "primary", "summary": "Q3 roadmap review", "start": "2018-06-19T10:00:00", "end": "2018-06-19T11:00:00"}],
     ["event", {"id": "ev_h03", "calendar": "primary", "summary": "Roadmap review - Q3", "start": "2018-06-20T10:00:00", "end": "2018-06-20T11:00:00"}],
     ["event", {"id": "ev_h04", "calendar": "primary", "summary": "Roadmap review - Q2", "start": "2018-06-21T10:00:00", "end": "2018-06-21T11:00:00"}]
   ],
   "expected": "Only the event titled exactly 'Roadmap review - Q3' (ev_h03) is renamed to 'Roadmap review - Q3 (final)'. The draft, reordered-words and Q2 lookalikes are left untouched.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_h03"}, "expected_count": 1, "expected_changes": {"summary": {"from": "Roadmap review - Q3", "to": "Roadmap review - Q3 (final)"}}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"not_in": ["ev_h03"]}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": {"i_contains": "roadmap"}}, "expected_count": 0}
   ]},

  {"id": "T02",
   "request": "For my Team sync on Tuesday that's in the Cedar room and shows me as free, rename it to 'Team sync (open door)'.",
   "seed": [
     ["event", {"id": "ev_m41", "calendar": "primary", "summary": "Team sync", "start": "2018-06-19T14:00:00", "end": "2018-06-19T14:30:00", "location": "Orchid room", "transparency": "transparent"}],
     ["event", {"id": "ev_m42", "calendar": "primary", "summary": "Team sync", "start": "2018-06-19T09:00:00", "end": "2018-06-19T09:30:00", "location": "Cedar room", "transparency": "opaque"}],
     ["event", {"id": "ev_m43", "calendar": "primary", "summary": "Team sync", "start": "2018-06-19T16:00:00", "end": "2018-06-19T16:30:00", "location": "Orchid room", "transparency": "opaque"}],
     ["event", {"id": "ev_m44", "calendar": "primary", "summary": "Team sync", "start": "2018-06-19T11:00:00", "end": "2018-06-19T11:30:00", "location": "Cedar room", "transparency": "transparent"}]
   ],
   "expected": "Only the Tuesday Team sync in the Cedar room that is marked free/transparent (ev_m44) is renamed. The Cedar-room event marked busy and the Orchid-room events stay unchanged.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_m44"}, "expected_count": 1, "expected_changes": {"summary": {"from": "Team sync", "to": "Team sync (open door)"}}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"not_in": ["ev_m44"]}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": {"i_contains": "team sync"}}, "expected_count": 0}
   ]},

  {"id": "T03",
   "request": "Change the location of the Vendor call on Thursday June 21 at 2pm to 'Zoom'.",
   "seed": [
     ["event", {"id": "ev_q71", "calendar": "primary", "summary": "Vendor call", "start": "2018-06-21T09:00:00", "end": "2018-06-21T10:00:00", "location": "Main office"}],
     ["event", {"id": "ev_q72", "calendar": "primary", "summary": "Vendor call", "start": "2018-06-28T14:00:00", "end": "2018-06-28T15:00:00", "location": "Main office"}],
     ["event", {"id": "ev_q73", "calendar": "primary", "summary": "Vendor call", "start": "2018-06-20T14:00:00", "end": "2018-06-20T15:00:00", "location": "Main office"}],
     ["event", {"id": "ev_q74", "calendar": "primary", "summary": "Vendor call", "start": "2018-06-21T14:00:00", "end": "2018-06-21T15:00:00", "location": "Main office"}],
     ["event", {"id": "ev_q75", "calendar": "primary", "summary": "Vendor call", "start": "2018-06-22T14:00:00", "end": "2018-06-22T15:00:00", "location": "Main office"}]
   ],
   "expected": "Only the Vendor call starting Thursday 2018-06-21 at 14:00 (ev_q74) gets location 'Zoom'. The other Vendor calls, on other days or at other times, are unchanged.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_q74"}, "expected_count": 1, "expected_changes": {"location": {"from": "Main office", "to": "Zoom"}}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"not_in": ["ev_q74"]}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": {"i_contains": "vendor"}}, "expected_count": 0}
   ]},

  {"id": "T04",
   "request": "Rename my Budget sync on June 21 to 'Budget sync - FY19'.",
   "seed": [
     ["event", {"id": "ev_b31", "calendar": "primary", "summary": "Budget sync", "start": "2018-06-22T08:00:00", "end": "2018-06-22T09:00:00"}],
     ["event", {"id": "ev_b32", "calendar": "primary", "summary": "Budget sync", "start": "2018-06-20T17:30:00", "end": "2018-06-20T18:30:00"}],
     ["event", {"id": "ev_b33", "calendar": "primary", "summary": "Budget sync", "start": "2018-06-21T19:00:00", "end": "2018-06-21T20:00:00"}]
   ],
   "expected": "The Budget sync that starts on June 21 in Los Angeles time (ev_b33, 19:00 local, which is already June 22 in UTC) is renamed. The one at 17:30 on June 20 local (June 21 in UTC) and the one on June 22 are left alone.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_b33"}, "expected_count": 1, "expected_changes": {"summary": {"from": "Budget sync", "to": "Budget sync - FY19"}}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"not_in": ["ev_b33"]}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": {"i_contains": "budget"}}, "expected_count": 0}
   ]},

  {"id": "T05",
   "request": "Add a 1-hour 'Planning hour' event to my primary calendar tomorrow at 10am.",
   "seed": [
     ["calendar", {"id": "cal_r21@northwind.example", "summary": "Primary", "owner": "actor", "access": "owner"}],
     ["calendar", {"id": "cal_r22@northwind.example", "summary": "Jordan Lee", "owner": "actor", "access": "owner"}]
   ],
   "expected": "One 'Planning hour' event is created on Jordan's actual primary calendar (jordan.lee@northwind.example), not on the secondary calendars that are merely named 'Primary' or 'Jordan Lee'.",
   "assertions": [
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": "Planning hour", "calendar_id": "jordan.lee@northwind.example"}, "expected_count": 1},
     {"diff_type": "added", "entity": "calendar_events", "where": {"calendar_id": {"ne": "jordan.lee@northwind.example"}}, "expected_count": 0}
   ]},

  {"id": "T06",
   "request": "Add a 'Handover' event to the Ops rota calendar that runs on Berlin time and that Kenji owns, on June 19 from 9:00 to 10:00 Berlin time.",
   "seed": [
     ["calendar", {"id": "cal_t51@northwind.example", "summary": "Ops rota", "owner": "aiko", "data_owner": "aiko.mori@northwind.example", "tz": "Asia/Tokyo", "access": "writer"}],
     ["calendar", {"id": "cal_t52@northwind.example", "summary": "Ops rota", "owner": "kenji", "data_owner": "kenji.sato@northwind.example", "tz": "Europe/Berlin", "access": "writer"}],
     ["calendar", {"id": "cal_t53@northwind.example", "summary": "Ops rota", "owner": "aiko", "data_owner": "aiko.mori@northwind.example", "tz": "Europe/Berlin", "access": "writer"}],
     ["calendar", {"id": "cal_t54@northwind.example", "summary": "Ops rota", "owner": "kenji", "data_owner": "kenji.sato@northwind.example", "tz": "Asia/Tokyo", "access": "writer"}]
   ],
   "expected": "The 'Handover' event is created only on cal_t52, the Ops rota calendar whose time zone is Europe/Berlin and whose data owner is Kenji. The Berlin calendar owned by Aiko and the Tokyo calendars get nothing.",
   "assertions": [
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": "Handover", "calendar_id": "cal_t52@northwind.example"}, "expected_count": 1},
     {"diff_type": "added", "entity": "calendar_events", "where": {"calendar_id": {"ne": "cal_t52@northwind.example"}}, "expected_count": 0}
   ]},

  {"id": "T07",
   "request": "Put a 'Launch checklist' event on June 25 from 3pm to 4pm on the Events calendar that I own and have hidden from my list.",
   "seed": [
     ["calendar", {"id": "cal_w61@northwind.example", "summary": "Events", "owner": "dana", "access": "writer", "hidden": true, "selected": false}],
     ["calendar", {"id": "cal_w62@northwind.example", "summary": "Events", "owner": "actor", "access": "owner", "hidden": false}],
     ["calendar", {"id": "cal_w63@northwind.example", "summary": "Events", "owner": "actor", "access": "owner", "hidden": true, "selected": false}],
     ["calendar", {"id": "cal_w64@northwind.example", "summary": "Events", "owner": "dana", "access": "writer", "hidden": false}]
   ],
   "expected": "The event is created only on cal_w63, the Events calendar where Jordan's access role is owner and whose list entry is hidden. The hidden calendar Jordan can only write to, and the visible Events calendars, stay empty.",
   "assertions": [
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": "Launch checklist", "calendar_id": "cal_w63@northwind.example"}, "expected_count": 1},
     {"diff_type": "added", "entity": "calendar_events", "where": {"calendar_id": {"ne": "cal_w63@northwind.example"}}, "expected_count": 0}
   ]},

  {"id": "T08",
   "request": "Add a 'Team offsite' event on June 27 from 9am to 5pm to my Tokyo trips calendar.",
   "seed": [
     ["calendar", {"id": "cal_v81@northwind.example", "summary": "Tokyo trips 2017", "owner": "kenji", "access": "writer"}],
     ["calendar", {"id": "cal_v82@northwind.example", "summary": "Trips - Tokyo", "owner": "leo", "access": "writer", "override": "Osaka trips"}],
     ["calendar", {"id": "cal_v83@northwind.example", "summary": "APAC roster", "owner": "kenji", "access": "writer", "override": "Tokyo trips"}]
   ],
   "expected": "The 'Team offsite' event is created on cal_v83, the calendar that Jordan's calendar list shows as 'Tokyo trips' (its summaryOverride), even though its own title is 'APAC roster'. The calendars merely titled 'Tokyo trips 2017' and 'Trips - Tokyo' get nothing.",
   "assertions": [
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": "Team offsite", "calendar_id": "cal_v83@northwind.example"}, "expected_count": 1},
     {"diff_type": "added", "entity": "calendar_events", "where": {"calendar_id": {"ne": "cal_v83@northwind.example"}}, "expected_count": 0}
   ]},

  {"id": "T09",
   "request": "Rename the Kickoff call on Wednesday that Maya created but Priya is organizing to 'Kickoff call - confirmed'.",
   "seed": [
     ["event", {"id": "ev_k91", "calendar": "primary", "summary": "Kickoff call", "start": "2018-06-20T11:00:00", "end": "2018-06-20T12:00:00", "organizer": "maya", "creator": "priya"}],
     ["event", {"id": "ev_k92", "calendar": "primary", "summary": "Kickoff call", "start": "2018-06-20T15:00:00", "end": "2018-06-20T16:00:00", "organizer": "priya", "creator": "priya"}],
     ["event", {"id": "ev_k93", "calendar": "primary", "summary": "Kickoff call", "start": "2018-06-20T09:00:00", "end": "2018-06-20T10:00:00", "organizer": "priya", "creator": "maya"}],
     ["event", {"id": "ev_k94", "calendar": "primary", "summary": "Kickoff call", "start": "2018-06-20T13:00:00", "end": "2018-06-20T14:00:00", "organizer": "maya", "creator": "maya"}]
   ],
   "expected": "Only the Kickoff call whose creator is Maya and whose organizer is Priya (ev_k93) is renamed. The swapped combination (created by Priya, organized by Maya) and the two same-person events are untouched.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_k93"}, "expected_count": 1, "expected_changes": {"summary": {"from": "Kickoff call", "to": "Kickoff call - confirmed"}}},
