     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"not_in": ["ev_p13"]}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"summary": {"i_contains": "planning meeting"}}, "expected_count": 0}
   ]},

