{"tests": [
  {"id": "T01",
   "request": "Bump the 'Session expires while uploading receipts' issue on the Mobile team to urgent.",
   "seed": [
     ["team", {"id": "t-11", "name": "Web", "key": "WEB"}],
     ["team", {"id": "t-12", "name": "Mobile", "key": "MOB"}],
     ["member", {"team": "t-11", "person": "actor"}],
     ["member", {"team": "t-12", "person": "actor"}],
     ["member", {"team": "t-11", "person": "maya"}],
     ["member", {"team": "t-12", "person": "maya"}],
     ["issue", {"id": "i-201", "team": "t-11", "number": 9, "title": "Session expires while uploading receipts", "priority": 3, "assignee": "maya", "created": "2026-05-01T09:00:00"}],
     ["issue", {"id": "i-202", "team": "t-12", "number": 4, "title": "Session expires while uploading receipts", "priority": 3, "assignee": "maya", "created": "2026-05-20T09:00:00"}],
     ["issue", {"id": "i-203", "team": "t-12", "number": 5, "title": "Session expires while uploading avatars", "priority": 3, "assignee": "maya", "created": "2026-05-22T09:00:00"}]
   ],
   "expected": "Sets the priority of the Mobile team's issue (MOB-4) to urgent (1). The Web team's issue with the same title and the similar avatar-upload issue stay untouched.",
   "assertions": [
     {"diff_type": "changed", "entity": "issues", "where": {"id": "i-202"}, "expected_changes": {"priority": {"from": 3, "to": 1}}},
     {"diff_type": "changed", "entity": "issues", "where": {"id": {"in": ["i-201", "i-203"]}}, "expected_count": 0}
   ]},

