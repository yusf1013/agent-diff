{"tests": [
  {"id": "T01",
   "request": "Set the topic of #ops-alerts to \"Pager rotation: see wiki\".",
   "seed": [
     ["channel", {"id": "C_7K1", "name": "ops-alert", "members": ["diego"], "topic": "Old single alerts"}],
     ["channel", {"id": "C_7K2", "name": "ops-alerts", "members": ["diego", "leo"], "topic": "On-call handoffs"}],
     ["channel", {"id": "C_7K3", "name": "ops-alerts-old", "members": ["diego"], "topic": "Legacy alerts"}],
     ["channel", {"id": "C_7K4", "name": "alerts-ops", "members": ["leo"], "topic": "Reverse name"}]
   ],
   "expected": "The assistant sets the topic of the channel named exactly #ops-alerts (not ops-alert, ops-alerts-old or alerts-ops) and leaves the other three channels untouched.",
   "assertions": [
     {"diff_type": "changed", "entity": "channels", "where": {"channel_id": "C_7K2"}, "expected_count": 1,
      "expected_changes": {"topic_text": {"from": "On-call handoffs", "to": "Pager rotation: see wiki"}}},
     {"diff_type": "changed", "entity": "channels", "where": {"channel_id": {"ne": "C_7K2"}}, "expected_count": 0}
   ]},

  {"id": "T02",
   "request": "Please add Priya Raman to #launch-room.",
   "seed": [
     ["person", {"key": "u7", "name": "Priya Raman", "set": {"title": "Finance Analyst"}}],
     ["channel", {"id": "C_2M1", "name": "launch-room", "members": ["diego", "leo"]}],
     ["channel", {"id": "C_2M2", "name": "general-chat", "members": ["priya", "u7", "maya"]}]
   ],
   "expected": "The assistant adds Priya Raman (not Priya Sharma, who shares the first name and display name) to #launch-room, and adds nobody else.",
   "assertions": [
     {"diff_type": "added", "entity": "channel_members", "where": {"channel_id": "C_2M1", "user_id": "U_U7"}, "expected_count": 1},
     {"diff_type": "added", "entity": "channel_members", "where": {"user_id": {"ne": "U_U7"}}, "expected_count": 0},
     {"diff_type": "removed", "entity": "channel_members", "expected_count": 0}
   ]},

  {"id": "T03",
   "request": "Delete Leo's refund message from 21 September in #support.",
   "seed": [
     ["channel", {"id": "C_3S1", "name": "support", "members": ["leo", "maya", "aisha"]}],
     ["message", {"channel": "C_3S1", "author": "leo", "text": "Refund for order 4471 issued.", "at": "2026-09-21T12:02:00Z", "ref": "m_a"}],
     ["message", {"channel": "C_3S1", "author": "maya", "text": "Refund for order 4471 issued, customer confirmed.", "at": "2026-09-21T12:10:00Z", "ref": "m_b"}],
     ["message", {"channel": "C_3S1", "author": "leo", "text": "Refund for order 4502 issued.", "at": "2026-09-22T12:05:00Z", "ref": "m_c"}],
     ["message", {"channel": "C_3S1", "author": "leo", "text": "Lunch anyone?", "at": "2026-09-21T12:30:00Z", "ref": "m_d"}]
   ],
   "expected": "The assistant deletes only Leo's refund message posted on 21 September (order 4471) and none of the other three messages (another author same day, same author next day, same author unrelated text).",
   "assertions": [
     {"diff_type": "removed", "entity": "messages", "where": {"message_id": "@m_a"}, "expected_count": 1},
     {"diff_type": "removed", "entity": "messages", "expected_count": 1}
   ]},

  {"id": "T04",
   "request": "In #eng, reply \"Noted, thanks\" in the thread where Diego announced the deploy freeze.",
   "seed": [
     ["channel", {"id": "C_4E1", "name": "eng", "members": ["diego", "leo", "omar"]}],
     ["message", {"channel": "C_4E1", "author": "omar", "text": "Should we do a deploy freeze during the offsite week?", "at": "2026-09-23T11:00:00Z", "ref": "r_a"}],
     ["message", {"channel": "C_4E1", "author": "diego", "text": "Deploy freeze starts Friday 18:00 UTC until Monday.", "at": "2026-09-23T11:20:00Z", "ref": "r_b"}],
     ["message", {"channel": "C_4E1", "author": "leo", "text": "Does the freeze cover hotfixes?", "at": "2026-09-23T11:25:00Z", "parent": "@r_b", "ref": "r_b1"}],
     ["message", {"channel": "C_4E1", "author": "diego", "text": "Deploy window today at 15:00 UTC.", "at": "2026-09-23T11:40:00Z", "ref": "r_c"}]
   ],
   "expected": "The assistant posts \"Noted, thanks\" as a threaded reply under Diego's freeze announcement (the root, not the other top-level messages) and posts nothing else.",
   "assertions": [
     {"diff_type": "added", "entity": "messages", "where": {"parent_id": "@r_b", "message_text": {"i_contains": "Noted, thanks"}}, "expected_count": 1},
     {"diff_type": "added", "entity": "messages", "expected_count": 1}
   ]},

  {"id": "T05",
   "request": "React with :white_check_mark: to the last message Omar sent in #releases.",
   "seed": [
     ["channel", {"id": "C_5R1", "name": "releases", "members": ["omar", "aisha", "priya"]}],
     ["channel", {"id": "C_5R2", "name": "random-talk", "members": ["omar", "aisha"]}],
     ["message", {"channel": "C_5R1", "author": "omar", "text": "Cutting rc1 now.", "at": "2026-09-24T11:00:00Z", "ref": "q_a"}],
     ["message", {"channel": "C_5R1", "author": "omar", "text": "rc1 is out, please smoke test.", "at": "2026-09-24T11:30:00Z", "ref": "q_b"}],
     ["message", {"channel": "C_5R1", "author": "aisha", "text": "Testing it now.", "at": "2026-09-24T11:45:00Z", "ref": "q_c"}],
     ["message", {"channel": "C_5R2", "author": "omar", "text": "Anyone up for coffee?", "at": "2026-09-24T12:15:00Z", "ref": "q_d"}]
   ],
   "expected": "The assistant adds a white_check_mark reaction to Omar's latest message in #releases (\"rc1 is out...\"), not to his later message in another channel, not to Aisha's later message, and adds no other reaction.",
   "assertions": [
     {"diff_type": "added", "entity": "message_reactions", "where": {"message_id": "@q_b", "user_id": "U01AGENBOT9", "reaction_type": "white_check_mark"}, "expected_count": 1},
     {"diff_type": "added", "entity": "message_reactions", "expected_count": 1}
   ]},

  {"id": "T06",
   "request": "Archive the #vendor-onboarding channel, we're done with it.",
   "seed": [
     ["channel", {"id": "C_6V1", "name": "vendor-payments", "members": ["maya", "leo"], "purpose": "Paying vendors"}],
     ["channel", {"id": "C_6V2", "name": "customer-onboarding", "members": ["maya", "aisha"], "purpose": "Onboarding new customers"}],
     ["channel", {"id": "C_6V3", "name": "vendors", "members": ["leo"], "purpose": "Vendor list"}],
     ["message", {"channel": "C_6V1", "author": "maya", "text": "Vendor invoices go out Friday.", "at": "2026-09-22T11:00:00Z", "ref": "n_a"}]
   ],
   "expected": "No channel called vendor-onboarding exists. The assistant tells the user it could not find it (optionally mentioning the similar channels) and archives nothing.",
   "assertions": [
     {"diff_type": "changed", "entity": "channels", "expected_count": 0},
     {"diff_type": "added", "entity": "messages", "expected_count": 0},
     {"diff_type": "removed", "entity": "messages", "expected_count": 0}
   ]},

  {"id": "T07",
   "request": "Take my :eyes: off the invoice 119 message in #finance.",
   "seed": [
     ["channel", {"id": "C_8F1", "name": "finance", "members": ["leo", "maya", "aisha"]}],
     ["message", {"channel": "C_8F1", "author": "leo", "text": "Invoice 118 needs approval.", "at": "2026-09-25T11:00:00Z", "ref": "i_a"}],
     ["message", {"channel": "C_8F1", "author": "maya", "text": "Invoice 119 needs approval.", "at": "2026-09-25T11:10:00Z", "ref": "i_b"}],
     ["message", {"channel": "C_8F1", "author": "aisha", "text": "Invoice 120 needs approval.", "at": "2026-09-25T11:20:00Z", "ref": "i_c"}],
     ["row", {"table": "message_reactions", "values": {"message_id": "@i_a", "user_id": "U01AGENBOT9", "reaction_type": "eyes"}}],
     ["row", {"table": "message_reactions", "values": {"message_id": "@i_b", "user_id": "U01AGENBOT9", "reaction_type": "eyes"}}],
     ["row", {"table": "message_reactions", "values": {"message_id": "@i_b", "user_id": "U01AGENBOT9", "reaction_type": "rocket"}}],
     ["row", {"table": "message_reactions", "values": {"message_id": "@i_b", "user_id": "U_MAYA", "reaction_type": "eyes"}}],
     ["row", {"table": "message_reactions", "values": {"message_id": "@i_c", "user_id": "U01AGENBOT9", "reaction_type": "eyes"}}]
   ],
   "expected": "The assistant removes only its own eyes reaction from the invoice 119 message. Its eyes reactions on invoices 118 and 120, its rocket reaction on 119, and Maya's eyes reaction on 119 all stay.",
   "assertions": [
     {"diff_type": "removed", "entity": "message_reactions", "where": {"message_id": "@i_b", "user_id": "U01AGENBOT9", "reaction_type": "eyes"}, "expected_count": 1},
     {"diff_type": "removed", "entity": "message_reactions", "expected_count": 1}
   ]},

  {"id": "T08",
   "request": "Delete Leo's message saying the standup moved to 10:30.",
   "seed": [
     ["channel", {"id": "C_9A1", "name": "team-eng", "members": ["leo", "diego"]}],
     ["channel", {"id": "C_9A2", "name": "team-support", "members": ["leo", "maya"]}],
     ["message", {"channel": "C_9A1", "author": "leo", "text": "Heads up: standup moved to 10:30 today.", "at": "2026-09-28T11:00:00Z", "ref": "s_a"}],
     ["message", {"channel": "C_9A2", "author": "leo", "text": "Heads up: standup moved to 10:30 today.", "at": "2026-09-28T11:02:00Z", "ref": "s_b"}],
     ["message", {"channel": "C_9A1", "author": "diego", "text": "Thanks, standup moved noted.", "at": "2026-09-28T11:05:00Z", "ref": "s_c"}]
   ],
   "expected": "Two identical messages from Leo match (one per channel) and the request gives nothing to tell them apart. The assistant does not guess and deletes nothing. It reports both matches and asks which one.",
   "assertions": [
     {"diff_type": "removed", "entity": "messages", "expected_count": 0},
     {"diff_type": "changed", "entity": "messages", "expected_count": 0},
     {"diff_type": "added", "entity": "messages", "expected_count": 0}
   ]},

  {"id": "T09",
   "request": "Add whoever heads up infrastructure to #incidents.",
   "seed": [
     ["person", {"key": "k3", "name": "Tomas Ruiz", "set": {"title": "Head of Infrastructure"}}],
     ["person", {"key": "k4", "name": "Nadia Voss", "set": {"title": "Infrastructure Intern"}}],
     ["person", {"key": "k5", "name": "Sam Ortega", "set": {"title": "Head of Marketing"}}],
     ["channel", {"id": "C_1I1", "name": "incidents", "members": ["diego", "leo"]}],
     ["channel", {"id": "C_1I2", "name": "infra-team", "members": ["k3", "k4"]}]
   ],
   "expected": "The assistant finds the person by title, Tomas Ruiz (Head of Infrastructure), and adds only him to #incidents, not the infrastructure intern or the head of marketing.",
   "assertions": [
     {"diff_type": "added", "entity": "channel_members", "where": {"channel_id": "C_1I1", "user_id": "U_K3"}, "expected_count": 1},
     {"diff_type": "added", "entity": "channel_members", "where": {"user_id": {"ne": "U_K3"}}, "expected_count": 0},
     {"diff_type": "removed", "entity": "channel_members", "expected_count": 0}
   ]},

  {"id": "T10",
   "request": "Unarchive the channel for our spring 2026 campaign.",
   "seed": [
     ["channel", {"id": "C_0M1", "name": "mkt-north", "members": ["aisha"], "purpose": "Autumn 2025 campaign", "set": {"is_archived": true}}],
     ["channel", {"id": "C_0M2", "name": "mkt-east", "members": ["aisha", "maya"], "purpose": "Spring 2026 campaign", "set": {"is_archived": true}}],
     ["channel", {"id": "C_0M3", "name": "mkt-west", "members": ["aisha"], "purpose": "Spring 2026 campaign planning notes for next year"}],
     ["channel", {"id": "C_0M4", "name": "mkt-south", "members": ["maya"], "purpose": "Spring 2025 campaign", "set": {"is_archived": true}}]
   ],
   "expected": "The assistant identifies the channel by its purpose (mkt-east, archived, Spring 2026 campaign) and unarchives only that one. The other archived channels and the active mkt-west stay as they are.",
   "assertions": [
     {"diff_type": "changed", "entity": "channels", "where": {"channel_id": "C_0M2"}, "expected_count": 1,
      "expected_changes": {"is_archived": {"from": true, "to": false}}},
     {"diff_type": "changed", "entity": "channels", "where": {"channel_id": {"ne": "C_0M2"}}, "expected_count": 0}
   ]},

