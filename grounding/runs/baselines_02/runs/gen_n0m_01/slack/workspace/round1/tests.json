   ]},

  {"id": "T12",
   "request": "Delete every message Maya posted in #scratch on 22 September.",
   "seed": [
     ["channel", {"id": "C_2X1", "name": "scratch", "members": ["maya", "leo"]}],
     ["channel", {"id": "C_2X2", "name": "scratch-pad", "members": ["maya"]}],
     ["message", {"channel": "C_2X1", "author": "maya", "text": "Draft one", "at": "2026-09-21T12:00:00Z", "ref": "x_a"}],
     ["message", {"channel": "C_2X1", "author": "maya", "text": "Draft two", "at": "2026-09-22T11:00:00Z", "ref": "x_b"}],
     ["message", {"channel": "C_2X1", "author": "leo", "text": "Looks good", "at": "2026-09-22T11:10:00Z", "ref": "x_c"}],
     ["message", {"channel": "C_2X1", "author": "maya", "text": "Draft three", "at": "2026-09-22T11:20:00Z", "ref": "x_d"}],
     ["message", {"channel": "C_2X1", "author": "maya", "text": "Reply on Leo's note", "at": "2026-09-22T12:30:00Z", "parent": "@x_c", "ref": "x_e"}],
     ["message", {"channel": "C_2X2", "author": "maya", "text": "Draft four", "at": "2026-09-22T12:40:00Z", "ref": "x_f"}]
   ],
   "expected": "The assistant deletes all three of Maya's messages posted in #scratch on 22 September, including the thread reply (x_b, x_d, x_e). It keeps her 21 September message, Leo's message and her message in #scratch-pad.",
   "assertions": [
     {"diff_type": "removed", "entity": "messages", "where": {"message_id": "@x_b"}, "expected_count": 1},
     {"diff_type": "removed", "entity": "messages", "where": {"message_id": "@x_d"}, "expected_count": 1},
     {"diff_type": "removed", "entity": "messages", "where": {"message_id": "@x_e"}, "expected_count": 1},
     {"diff_type": "removed", "entity": "messages", "expected_count": 3}
   ]}
]}
