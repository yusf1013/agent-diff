   ]},

  {"id": "T05",
   "request": "Just for this Tuesday, the team standup will be in Room 9 instead. Please update that, and leave the other weeks as they are.",
   "seed": [
     ["event", {"id": "ev_r9x", "calendar": "primary", "summary": "Team standup", "start": "2018-06-05T09:30:00", "end": "2018-06-05T09:45:00", "location": "Room 2", "recurrence": ["RRULE:FREQ=WEEKLY;BYDAY=TU"], "attendees": [["actor", "accepted"], ["sam", "accepted"], ["maya", "accepted"]]}]
   ],
   "expected": "Changes the location to Room 9 only for the Tuesday 2018-06-19 occurrence (an instance exception) and leaves the recurring series itself, with location Room 2, unchanged for all other weeks.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_r9x"}, "expected_count": 0},
     {"diff_type": "removed", "entity": "calendar_events", "where": {"id": "ev_r9x"}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {"location": "Room 9"}, "expected_count": {"min": 0, "max": 1}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"location": "Room 9"}, "expected_count": {"min": 0, "max": 1}}
   ]},

