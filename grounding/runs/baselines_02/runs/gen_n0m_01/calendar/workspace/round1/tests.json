{"tests": [
  {"id": "T01",
   "request": "My dentist's office moved. Please change the location of my dentist appointment this Thursday to 210 Pine St, Suite 4B.",
   "seed": [
     ["event", {"id": "ev_k41", "calendar": "primary", "summary": "Dentist appointment", "start": "2018-06-14T10:00:00", "end": "2018-06-14T11:00:00", "location": "Main St Clinic"}],
     ["event", {"id": "ev_q82", "calendar": "primary", "summary": "Dentist appointment", "start": "2018-06-21T10:00:00", "end": "2018-06-21T11:00:00", "location": "Main St Clinic"}],
     ["event", {"id": "ev_m17", "calendar": "primary", "summary": "Dentist appointment", "start": "2018-06-28T10:00:00", "end": "2018-06-28T11:00:00", "location": "Main St Clinic"}]
   ],
   "expected": "Updates the location of only the dentist appointment on Thursday 2018-06-21 to 210 Pine St, Suite 4B, leaving the past (06-14) and later (06-28) dentist appointments untouched.",
   "assertions": [
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": "ev_q82"}, "expected_changes": {"location": {"from": "Main St Clinic", "to": {"contains": "210 Pine St"}}}},
     {"diff_type": "changed", "entity": "calendar_events", "where": {"id": {"ne": "ev_q82"}}, "expected_count": 0},
     {"diff_type": "added", "entity": "calendar_events", "where": {}, "expected_count": 0},
     {"diff_type": "removed", "entity": "calendar_events", "where": {}, "expected_count": 0}
   ]},

  {"id": "T02",
