{
  "description": "Removes a reaction from an item.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "name": {
        "type": "string",
        "required": true,
        "description": "Reaction (emoji) name."
      },
      "channel": {
        "type": "string",
        "required": false,
        "description": "Channel where the message to remove reaction from was posted."
      },
      "timestamp": {
        "type": "string",
        "required": false,
        "description": "Timestamp of the message to remove reaction from."
      },
      "file": {
        "type": "string",
        "required": false,
        "description": "File to remove reaction from."
      },
      "file_comment": {
        "type": "string",
        "required": false,
        "description": "File comment to remove reaction from."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/reactions.remove\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\",\n       \"name\": \"thumbsup\",\n       \"timestamp\": \"1234567890.123456\"\n     }'"
}
