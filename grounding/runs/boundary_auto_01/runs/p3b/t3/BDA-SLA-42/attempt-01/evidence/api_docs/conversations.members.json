{
  "description": "Retrieve members of a conversation.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "ID of the conversation to retrieve members for."
      },
      "cursor": {
        "type": "string",
        "required": false,
        "description": "Paginate through collections by setting cursor to next_cursor."
      },
      "limit": {
        "type": "integer",
        "required": false,
        "description": "Maximum number of items to return. Default: 100."
      }
    }
  },
  "example_request": "curl -X GET \"https://slack.com/api/conversations.members?channel=C1234567890&limit=100\" \\\n     -H \"Authorization: Bearer <TOKEN>\""
}
