{
  "root_table": "messages",
  "scope": [],
  "focal": {
    "path": [
      "messages",
      "message_reactions",
      "users"
    ],
    "joins": [
      "message_reactions.message_id",
      "message_reactions.user_id"
    ],
    "filters": [
      {
        "node": 1,
        "field": "reaction_type",
        "op": "eq",
        "value": "raised_hands"
      },
      {
        "node": 2,
        "field": "real_name",
        "op": "eq",
        "value": "Priya Sharma"
      }
    ]
  },
  "auxiliary": []
}
