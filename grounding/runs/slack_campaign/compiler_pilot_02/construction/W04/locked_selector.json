{
  "root_table": "messages",
  "scope": [],
  "focal": {
    "path": [
      "messages",
      "message_reactions",
      "users",
      "channel_members",
      "channels"
    ],
    "joins": [
      "message_reactions.message_id",
      "message_reactions.user_id",
      "channel_members.user_id",
      "channel_members.channel_id"
    ],
    "filters": [
      {
        "node": 0,
        "field": "message_text",
        "op": "contains_ci",
        "value": "rollout checklist"
      },
      {
        "node": 1,
        "field": "reaction_type",
        "op": "eq",
        "value": "rocket"
      },
      {
        "node": 4,
        "field": "channel_name",
        "op": "eq",
        "value": "beta-testers"
      }
    ]
  },
  "auxiliary": []
}
