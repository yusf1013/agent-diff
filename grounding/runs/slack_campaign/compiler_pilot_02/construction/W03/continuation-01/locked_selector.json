{
  "root_table": "channels",
  "scope": [],
  "focal": {
    "path": [
      "channels",
      "messages",
      "message_reactions",
      "users"
    ],
    "joins": [
      "messages.channel_id",
      "message_reactions.message_id",
      "message_reactions.user_id"
    ],
    "filters": [
      {
        "node": 1,
        "field": "message_text",
        "op": "contains_ci",
        "value": "budget approved"
      },
      {
        "node": 2,
        "field": "reaction_type",
        "op": "eq",
        "value": "tada"
      },
      {
        "node": 3,
        "field": "real_name",
        "op": "contains_ci",
        "value": "Alex"
      }
    ]
  },
  "auxiliary": []
}
