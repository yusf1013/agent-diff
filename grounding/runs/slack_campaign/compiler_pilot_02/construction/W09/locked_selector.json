{
  "root_table": "teams",
  "scope": [],
  "focal": {
    "path": [
      "teams",
      "user_teams",
      "users",
      "channel_members",
      "channels"
    ],
    "joins": [
      "user_teams.team_id",
      "user_teams.user_id",
      "channel_members.user_id",
      "channel_members.channel_id"
    ],
    "filters": [
      {
        "node": 2,
        "field": "is_bot",
        "op": "eq",
        "value": true
      },
      {
        "node": 4,
        "field": "channel_name",
        "op": "eq",
        "value": "incident-response"
      }
    ]
  },
  "auxiliary": []
}
