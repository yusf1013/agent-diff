{
  "root_table": "channel_members",
  "scope": [],
  "focal": {
    "path": [
      "channel_members",
      "users",
      "message_reactions",
      "messages",
      "channels"
    ],
    "joins": [
      "channel_members.user_id",
      "message_reactions.user_id",
      "message_reactions.message_id",
      "messages.channel_id"
    ],
    "filters": [
      {
        "node": 1,
        "field": "real_name",
        "op": "contains_ci",
        "value": "Jordan"
      },
      {
        "node": 2,
        "field": "reaction_type",
        "op": "eq",
        "value": "thumbsup"
      },
      {
        "node": 3,
        "field": "message_text",
        "op": "contains_ci",
        "value": "security audit"
      },
      {
        "node": 4,
        "field": "channel_name",
        "op": "eq",
        "value": "announcements"
      }
    ]
  },
  "auxiliary": [
    {
      "path": [
        "channel_members",
        "channels"
      ],
      "joins": [
        "channel_members.channel_id"
      ],
      "filters": [
        {
          "node": 1,
          "field": "channel_name",
          "op": "eq",
          "value": "general"
        }
      ]
    }
  ]
}
