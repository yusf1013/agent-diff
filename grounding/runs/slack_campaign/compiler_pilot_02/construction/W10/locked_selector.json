{
  "root_table": "user_teams",
  "scope": [],
  "focal": {
    "path": [
      "user_teams",
      "users",
      "message_reactions",
      "messages",
      "channels",
      "channel_members",
      "users"
    ],
    "joins": [
      "user_teams.user_id",
      "message_reactions.user_id",
      "message_reactions.message_id",
      "messages.channel_id",
      "channel_members.channel_id",
      "channel_members.user_id"
    ],
    "filters": [
      {
        "node": 2,
        "field": "reaction_type",
        "op": "eq",
        "value": "rocket"
      },
      {
        "node": 3,
        "field": "message_text",
        "op": "eq",
        "value": "Launch checklist ready for review"
      },
      {
        "node": 6,
        "field": "username",
        "op": "eq",
        "value": "priya"
      }
    ]
  },
  "auxiliary": []
}
