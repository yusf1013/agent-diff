{
  "description": "Renames a conversation.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "ID of conversation to rename."
      },
      "name": {
        "type": "string",
        "required": true,
        "description": "New name for conversation."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/conversations.rename\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\",\n       \"name\": \"new-channel-name\"\n     }'"
}
