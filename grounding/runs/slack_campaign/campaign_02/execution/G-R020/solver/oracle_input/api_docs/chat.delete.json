{
  "description": "Deletes a message.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "Channel containing the message to be deleted."
      },
      "ts": {
        "type": "string",
        "required": true,
        "description": "Timestamp of the message to be deleted."
      }
    }
  },
  "example_request": "curl -X POST \"https://slack.com/api/chat.delete\" \\\n     -H \"Authorization: Bearer <TOKEN>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n       \"channel\": \"C1234567890\",\n       \"ts\": \"1405894322.002768\"\n     }'"
}
