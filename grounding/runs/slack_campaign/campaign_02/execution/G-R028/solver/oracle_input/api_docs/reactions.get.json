{
  "description": "Gets reactions for an item.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": false,
        "description": "Channel where the message to get reactions for was posted."
      },
      "timestamp": {
        "type": "string",
        "required": false,
        "description": "Timestamp of the message to get reactions for."
      },
      "file": {
        "type": "string",
        "required": false,
        "description": "File to get reactions for."
      },
      "file_comment": {
        "type": "string",
        "required": false,
        "description": "File comment to get reactions for."
      },
      "full": {
        "type": "boolean",
        "required": false,
        "description": "If true, always return the complete reaction list. Default: false."
      }
    }
  },
  "example_request": "curl -X GET \"https://slack.com/api/reactions.get?channel=C1234567890&timestamp=1234567890.123456\" \\\n     -H \"Authorization: Bearer <TOKEN>\""
}
