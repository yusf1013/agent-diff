{
  "root_table": "users",
  "scope": [],
  "focal": {
    "path": [
      "users",
      "message_reactions",
      "messages",
      "channels"
    ],
    "joins": [
      "message_reactions.user_id",
      "message_reactions.message_id",
      "messages.channel_id"
    ],
    "filters": [
      {
        "node": 1,
        "field": "reaction_type",
        "op": "eq",
        "value": "fire"
      },
      {
        "node": 2,
        "field": "message_text",
        "op": "contains_ci",
        "value": "budget freeze"
      },
      {
        "node": 3,
        "field": "channel_name",
        "op": "eq",
        "value": "finance"
      }
    ]
  },
  "auxiliary": []
}
