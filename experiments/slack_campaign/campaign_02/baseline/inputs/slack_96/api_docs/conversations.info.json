{
  "description": "Retrieve information about a conversation.",
  "parameters": {
    "body": {
      "token": {
        "type": "string",
        "required": true,
        "description": "Authentication token bearing required scopes."
      },
      "channel": {
        "type": "string",
        "required": true,
        "description": "Conversation ID to learn more about."
      },
      "include_locale": {
        "type": "boolean",
        "required": false,
        "description": "Set to true to receive the locale for this conversation. Default: false."
      },
      "include_num_members": {
        "type": "boolean",
        "required": false,
        "description": "Set to true to include the member count. Default: false."
      }
    }
  },
  "example_request": "curl -X GET \"https://slack.com/api/conversations.info?channel=C1234567890\" \\\n     -H \"Authorization: Bearer <TOKEN>\""
}
