{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oracle assessment of one completed test run",
  "description": "Proposed output contract. Input cards do not change. Semantic rules are in oracle-schema-guide.md.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "base_violation_registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      },
      "minItems": 1
    },
    "unexpected_effects": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unexpected_effect"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment_issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/assessment_issue"
        },
        {
          "type": "null"
        }
      ]
    },
    "new_violation_codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code_definition"
      }
    }
  },
  "required": [
    "schema_version",
    "test_id",
    "run_id",
    "base_violation_registry_version",
    "obligations",
    "unexpected_effects",
    "assessment_issue",
    "new_violation_codes"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "prompt",
            "card",
            "initial_state",
            "final_state",
            "response",
            "trajectory",
            "domain_semantics"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "location",
        "detail"
      ],
      "additionalProperties": false
    },
    "assessment_issue": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "blocked_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "blocked_fields"
      ],
      "additionalProperties": false
    },
    "grounding_assessment": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "demonstrated_correct",
            "demonstrated_incorrect",
            "not_established",
            null
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false
    },
    "violation": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "description"
      ],
      "additionalProperties": false
    },
    "code_definition": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "applies_to": {
          "enum": [
            "outcome_violations",
            "unexpected_effects"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "applies_to",
        "definition",
        "exclusions",
        "example"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^A[0-9]{3,}$"
        },
        "requested_action": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "read-only",
                "state-changing",
                null
              ]
            },
            "prompt_excerpt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "description",
            "type",
            "prompt_excerpt"
          ],
          "additionalProperties": false
        },
        "observed_behavior": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "target_ids": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "description",
            "target_ids"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "grounding_assessment": {
          "$ref": "#/$defs/grounding_assessment"
        },
        "downstream_action_outcome": {
          "enum": [
            "completed",
            "partially_completed",
            "failed",
            "deferred",
            "omitted",
            "interrupted",
            null
          ]
        },
        "outcome_explanation": {
          "type": "string",
          "minLength": 1
        },
        "outcome_violations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/violation"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "requested_action",
        "observed_behavior",
        "evidence",
        "grounding_assessment",
        "downstream_action_outcome",
        "outcome_explanation",
        "outcome_violations"
      ],
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^O[0-9]{3,}$"
        },
        "obligation_name": {
          "type": "string",
          "minLength": 1
        },
        "card_ref": {
          "type": "string",
          "minLength": 1
        },
        "linked_downstream_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "overall_grounding_assessment": {
          "$ref": "#/$defs/grounding_assessment"
        },
        "assessment_issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/assessment_issue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligation_id",
        "obligation_name",
        "card_ref",
        "linked_downstream_actions",
        "overall_grounding_assessment",
        "assessment_issue"
      ],
      "additionalProperties": false
    },
    "unexpected_effect": {
      "type": "object",
      "properties": {
        "effect_id": {
          "type": "string",
          "pattern": "^E[0-9]{3,}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "related_action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "authorization_explanation": {
          "type": "string",
          "minLength": 1
        },
        "recovery_explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "effect_id",
        "code",
        "description",
        "target_ids",
        "related_action_ids",
        "authorization_explanation",
        "recovery_explanation",
        "evidence"
      ],
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "properties": {
        "registry_version": {
          "type": "integer",
          "minimum": 1
        },
        "codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code_definition"
          },
          "minItems": 1
        }
      },
      "required": [
        "registry_version",
        "codes"
      ],
      "additionalProperties": false
    }
  }
}
